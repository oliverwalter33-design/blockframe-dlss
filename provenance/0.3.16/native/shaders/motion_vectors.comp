#version 450

#ifndef BLOCKFRAME_DEVELOPER_DIAGNOSTICS
#define BLOCKFRAME_DEVELOPER_DIAGNOSTICS 0
#endif

// Dense, low-resolution motion-vector resolve for Minecraft's Vulkan world target.
// Vectors point from the current unjittered pixel position to the previous
// unjittered pixel position and are stored in render-resolution pixel units.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D CurrentDepth;
layout(set = 0, binding = 2, rg16f) uniform writeonly image2D MotionOutput;
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D DepthDebugOutput;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D MotionDebugOutput;
#endif
layout(set = 0, binding = 7, rgba8) uniform writeonly image2D TransparencyHintOutput;
layout(set = 0, binding = 8) uniform sampler2D CurrentColor;
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
layout(set = 0, binding = 9, r8ui) uniform writeonly uimage2D MotionValidityOutput;
#endif

struct MotionObject {
    vec4 boundsMin;
    vec4 boundsMax;
    vec4 previousPosition;
    vec4 currentPosition;
    vec4 rotations;
};

struct ArticulatedPart {
    mat4 currentWorldToLocal;
    mat4 previousLocalToWorld;
    vec4 localBoundsMin;
    vec4 localBoundsMax;
};

layout(std140, set = 0, binding = 3) uniform FrameData {
    mat4 inverseCurrentViewProjection;
    mat4 previousViewProjection;
    // Camera-relative current-clip -> previous-clip mapping. Static world
    // motion uses this directly, avoiding an absolute-world float round trip.
    mat4 currentClipToPreviousClip;
    vec4 renderSizeAndCurrentJitter;
    // x = rigid object count, y = temporal reset, z = reserved,
    // w = developer capture outputs enabled.
    ivec4 flags;
    // Coarse world bounds only reject pixels that cannot touch the avatar.
    // Exact ownership is resolved against the oriented cube geometry below.
    vec4 articulatedBoundsMin;
    vec4 articulatedBoundsMax;
    // x = part count, y = capture overflow (exact path disabled if non-zero).
    ivec4 articulatedFlags;
    MotionObject objects[64];
    ArticulatedPart articulatedParts[96];
} frame;

const float BACKGROUND_DEPTH_EPSILON = 1.0e-7;
const uint MOTION_CLASS_WORLD = 0u;
const uint MOTION_CLASS_ARTICULATED_PLAYER = 1u;
const uint MOTION_CLASS_LEGACY_RIGID = 2u;
const uint MOTION_CLASS_WORLD_OUTSIDE = 3u;
const uint MOTION_CLASS_STORAGE_SATURATED = 4u;
const uint MOTION_CLASS_RESET = 128u;
const uint MOTION_CLASS_RECONSTRUCTION_INVALID = 129u;
const uint MOTION_CLASS_PREVIOUS_PROJECTION_INVALID = 130u;
const uint MOTION_CLASS_NONFINITE = 131u;

vec3 rotateY(vec3 value, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return vec3(c * value.x + s * value.z, value.y, -s * value.x + c * value.z);
}

bool reprojectArticulatedAvatar(vec3 currentWorld, out vec3 previousWorld) {
    int partCount = clamp(frame.articulatedFlags.x, 0, 96);
    if (partCount == 0 || frame.articulatedFlags.y != 0) {
        return false;
    }
    const float coarsePadding = 0.10;
    if (any(lessThan(currentWorld, frame.articulatedBoundsMin.xyz - coarsePadding))
        || any(greaterThan(currentWorld, frame.articulatedBoundsMax.xyz + coarsePadding))) {
        return false;
    }

    // Mojang's player mesh is a hierarchy of rigid cuboids. Reconstruct the
    // exact current cube-local coordinate, then apply the matching previous
    // model-part matrix. The tolerance is geometric only; the closest actual
    // cube surface wins, so transparent outer-layer holes resolve to the
    // underlying body cube instead of becoming a box-shaped screen mask.
    const float localTolerance = 0.75 / 16.0;
    float bestSurfaceDistance = 1.0e30;
    vec3 bestPreviousWorld = currentWorld;
    bool matched = false;
    for (int i = 0; i < partCount; ++i) {
        ArticulatedPart part = frame.articulatedParts[i];
        vec4 localH = part.currentWorldToLocal * vec4(currentWorld, 1.0);
        if (abs(localH.w) <= 1.0e-7) {
            continue;
        }
        vec3 local = localH.xyz / localH.w;
        vec3 outsideLow = max(part.localBoundsMin.xyz - local, vec3(0.0));
        vec3 outsideHigh = max(local - part.localBoundsMax.xyz, vec3(0.0));
        vec3 outside = max(outsideLow, outsideHigh);
        if (max(max(outside.x, outside.y), outside.z) > localTolerance) {
            continue;
        }
        vec3 distanceToMin = abs(local - part.localBoundsMin.xyz);
        vec3 distanceToMax = abs(part.localBoundsMax.xyz - local);
        float surfaceDistance = min(
            min(min(distanceToMin.x, distanceToMin.y), distanceToMin.z),
            min(min(distanceToMax.x, distanceToMax.y), distanceToMax.z)
        );
        // Being somewhere inside a cuboid is not coverage. Requiring an
        // actual cube surface prevents a wall or the ground behind the avatar
        // from being classified as player geometry.
        if (surfaceDistance > localTolerance) {
            continue;
        }
        if (surfaceDistance >= bestSurfaceDistance) {
            continue;
        }
        vec4 previousH = part.previousLocalToWorld * vec4(local, 1.0);
        if (abs(previousH.w) <= 1.0e-7) {
            continue;
        }
        bestSurfaceDistance = surfaceDistance;
        bestPreviousWorld = previousH.xyz / previousH.w;
        matched = true;
    }
    previousWorld = bestPreviousWorld;
    return matched;
}

vec3 hsvToRgb(float hue, float saturation, float value) {
    vec3 p = abs(fract(vec3(hue) + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return value * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), saturation);
}

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec2(vec2 value) {
    return all(not(isnan(value))) && all(not(isinf(value)));
}

bool finiteVec4(vec4 value) {
    return all(not(isnan(value))) && all(not(isinf(value)));
}

void writeMotion(
    ivec2 pixel,
    vec2 motion,
    uint motionClass
) {
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
    bool invalid = motionClass >= MOTION_CLASS_RESET;
#endif
    // Never encode a sentinel, NaN or infinity. A finite previous projection,
    // including one outside the viewport, remains valid dense motion.
    if (!finiteVec2(motion)) {
        motion = vec2(0.0);
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
        motionClass = MOTION_CLASS_NONFINITE;
        invalid = true;
#endif
    } else {
        // MotionOutput is RG16F. Float32 values can be finite here yet turn
        // into infinity during the format conversion in imageStore. Scale
        // the complete vector, rather than clamping components independently,
        // so an off-screen reprojection keeps its direction. 65024 is exactly
        // representable as binary16 and leaves a 15-step safety margin below
        // that format's maximum finite value.
        const float maxFiniteMotionComponent = 65024.0;
        float largestComponent = max(abs(motion.x), abs(motion.y));
        if (largestComponent > maxFiniteMotionComponent) {
            motion *= maxFiniteMotionComponent / largestComponent;
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
            if (motionClass < MOTION_CLASS_RESET) {
                motionClass = MOTION_CLASS_STORAGE_SATURATED;
            }
#endif
        }
    }
    imageStore(MotionOutput, pixel, vec4(motion, 0.0, 0.0));
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
    if (frame.flags.w != 0) {
        imageStore(MotionValidityOutput, pixel, uvec4(motionClass));
        if (invalid) {
            imageStore(MotionDebugOutput, pixel, vec4(1.0, 0.0, 1.0, 1.0));
        } else {
            float magnitude = length(motion);
            float angle = atan(motion.y, motion.x) / 6.28318530718 + 0.5;
            float brightness = clamp(0.12 + magnitude / 16.0, 0.12, 1.0);
            imageStore(MotionDebugOutput, pixel, vec4(hsvToRgb(angle, 1.0, brightness), 1.0));
        }
    }
#endif
}

bool isTransparencyCompositePixel(ivec2 pixel) {
    float materialAlpha = texelFetch(CurrentColor, pixel, 0).a;
    const float compositionMarkerAlpha = 253.0 / 255.0;
    const float particleMarkerAlpha = 252.0 / 255.0;
    return abs(materialAlpha - compositionMarkerAlpha) < (0.5 / 255.0)
        || abs(materialAlpha - particleMarkerAlpha) < (0.5 / 255.0);
}

void writeTransparencyHint(ivec2 pixel) {
    // Own-pixel only: this marker describes the same visible surface as
    // CurrentColor[p] and CurrentDepth[p]. It never borrows a screen neighbor.
    float hint = isTransparencyCompositePixel(pixel)
        ? 1.0
        : 0.0;
    imageStore(TransparencyHintOutput, pixel, vec4(hint));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(frame.renderSizeAndCurrentJitter.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    // Color, depth and motion always describe this exact visible pixel. Alpha
    // holes therefore retain the motion of the surface actually visible
    // behind them instead of borrowing a nearby grass/leaf sample.
    float depth = texelFetch(CurrentDepth, pixel, 0).r;
    writeTransparencyHint(pixel);
#if BLOCKFRAME_DEVELOPER_DIAGNOSTICS
    if (frame.flags.w != 0) {
        float visibleDepth = pow(clamp(depth, 0.0, 1.0), 0.25);
        imageStore(DepthDebugOutput, pixel, vec4(vec3(visibleDepth), 1.0));
    }
#endif

    vec2 currentJitter = frame.renderSizeAndCurrentJitter.zw;
    vec2 currentUvJittered =
        (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 currentUv = currentUvJittered - currentJitter / vec2(size);
    if (frame.flags.y != 0) {
        writeMotion(pixel, vec2(0.0), MOTION_CLASS_RESET);
        return;
    }
    if (!finiteFloat(depth) || !finiteVec2(currentUv)) {
        writeMotion(
            pixel,
            vec2(0.0),
            MOTION_CLASS_RECONSTRUCTION_INVALID
        );
        return;
    }

    vec4 currentClip = vec4(currentUv * 2.0 - 1.0, depth, 1.0);
    bool currentIsBackground = depth <= BACKGROUND_DEPTH_EPSILON;
    vec4 previousClip;
    uint resolvedMotionClass = MOTION_CLASS_WORLD;
    if (currentIsBackground) {
        // Reversed-Z depth zero is the infinitely distant sky. Reconstruct a
        // direction (w=0) so camera translation cannot move it.
        vec4 farWorldH = frame.inverseCurrentViewProjection * currentClip;
        vec4 nearWorldH = frame.inverseCurrentViewProjection
            * vec4(currentUv * 2.0 - 1.0, 1.0, 1.0);
        if (!finiteVec4(farWorldH) || !finiteVec4(nearWorldH)) {
            writeMotion(
                pixel,
                vec2(0.0),
                MOTION_CLASS_RECONSTRUCTION_INVALID
            );
            return;
        }
        vec3 worldDirection = farWorldH.xyz;
        if (
            abs(farWorldH.w) > 1.0e-7
                && abs(nearWorldH.w) > 1.0e-7
        ) {
            worldDirection = farWorldH.xyz / farWorldH.w
                - nearWorldH.xyz / nearWorldH.w;
        }
        previousClip = frame.previousViewProjection
            * vec4(worldDirection, 0.0);
    } else {
        previousClip = frame.currentClipToPreviousClip * currentClip;
        // Absolute-world reconstruction is retained only for the unchanged
        // dev.3 articulated/rigid object ownership path. Static world motion
        // above never pays its large-coordinate precision loss.
        vec4 currentWorldH = frame.inverseCurrentViewProjection * currentClip;
        if (!finiteVec4(currentWorldH) || abs(currentWorldH.w) <= 1.0e-7) {
            writeMotion(
                pixel,
                vec2(0.0),
                MOTION_CLASS_RECONSTRUCTION_INVALID
            );
            return;
        }

        vec3 currentWorld = currentWorldH.xyz / currentWorldH.w;
        vec3 previousWorld = currentWorld;
        bool articulatedPlayer = reprojectArticulatedAvatar(
            currentWorld,
            previousWorld
        );
        resolvedMotionClass = articulatedPlayer
            ? MOTION_CLASS_ARTICULATED_PLAYER
            : MOTION_CLASS_WORLD;
        if (!articulatedPlayer) {
            int objectCount = clamp(frame.flags.x, 0, 64);
            for (int i = 0; i < objectCount; ++i) {
                MotionObject object = frame.objects[i];
                vec3 padding = vec3(0.075);
                if (all(greaterThanEqual(currentWorld, object.boundsMin.xyz - padding))
                    && all(lessThanEqual(currentWorld, object.boundsMax.xyz + padding))) {
                    vec3 local = rotateY(currentWorld - object.currentPosition.xyz, -object.rotations.x);
                    previousWorld = object.previousPosition.xyz + rotateY(local, object.rotations.y);
                    resolvedMotionClass = MOTION_CLASS_LEGACY_RIGID;
                    break;
                }
            }
        }
        if (resolvedMotionClass != MOTION_CLASS_WORLD) {
            previousClip = frame.previousViewProjection
                * vec4(previousWorld, 1.0);
        }
    }
    if (!finiteVec4(previousClip) || previousClip.w <= 1.0e-7) {
        writeMotion(
            pixel,
            vec2(0.0),
            MOTION_CLASS_PREVIOUS_PROJECTION_INVALID
        );
        return;
    }

    vec3 previousNdc = previousClip.xyz / previousClip.w;
    if (any(isnan(previousNdc)) || any(isinf(previousNdc))) {
        writeMotion(pixel, vec2(0.0), MOTION_CLASS_NONFINITE);
        return;
    }
    vec2 previousUv = previousNdc.xy * 0.5 + 0.5;
    vec2 motionPixels = (previousUv - currentUv) * vec2(size);
    if (
        resolvedMotionClass == MOTION_CLASS_WORLD
            && (
                any(lessThan(previousUv, vec2(0.0)))
                    || any(greaterThan(previousUv, vec2(1.0)))
            )
    ) {
        resolvedMotionClass = MOTION_CLASS_WORLD_OUTSIDE;
    }
    writeMotion(pixel, motionPixels, resolvedMotionClass);
}
